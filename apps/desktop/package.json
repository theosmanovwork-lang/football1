    "preview": "electron-vite preview"
  },
  "devDependencies": {
    "@fm/shared": "0.0.1",
    "@fm/sim": "0.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "author": "FM project"
}
