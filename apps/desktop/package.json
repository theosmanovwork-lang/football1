{
  "name": "@fm/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Football manager desktop app",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
